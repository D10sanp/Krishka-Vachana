# Copy this file to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=development

# --- Firebase Admin SDK -------------------------------------------------
# The Database & Infrastructure engineer owns the Firebase project, auth
# config and Firestore security rules. Ask them for a service-account key
# for local backend development, or use `firebase emulators:start` and
# point FIREBASE_EMULATOR_HOST at it instead.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=krishka-vachana

# Convenience: sets both emulators to the same host:port. Prefer the two
# overrides below instead if Auth and Firestore emulators run on different
# ports (the Firebase Local Emulator Suite defaults do - 9099 vs 8080).
FIREBASE_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# If no Firebase service account / emulator is configured, authenticated
# endpoints return 401 by default. Mock authentication (an in-memory store
# and accepting any bearer token as the farmer's uid) is only available if
# you explicitly opt in below - it is NOT enabled automatically just because
# Firebase is unset. See app/core/firebase.py, app/api/deps.py, and
# app/repositories/memory.py.
# SECURITY: defaults to false (fail closed). Only flip to true on your own
# machine for local development - if this is ever true in a real deployment
# that also lacks Firebase credentials, any bearer token is accepted as a
# farmer's identity. Never set this to true outside local dev.
ALLOW_DEV_AUTH_FALLBACK=false

# Full Google Secret Manager version resource for a unique 32+ byte key,
# used to fingerprint Aadhaar numbers for uniqueness checks without ever
# storing the plaintext number. MUST pin an explicit numeric version - NOT
# "latest" or any other alias, which the app rejects at startup/first use.
# A mutable alias could rotate silently underneath the app and break
# Aadhaar duplicate-detection with no warning. See the comment at the top
# of app/core/secrets.py for what pinning does and does not protect against
# (rotating this value has a real trade-off - read that before rotating).
AADHAAR_HMAC_SECRET_NAME=projects/PROJECT_ID/secrets/aadhaar-hmac-key/versions/1

# --- AI/ML congestion-prediction integration point (Phase 2) -------------
# AI/ML's real endpoint doesn't exist yet. Leave this unset and Smart Slot
# congestion predictions are served by a deterministic occupancy heuristic
# instead (see app/services/congestion_service.py). Once AI/ML stands up a
# model behind an HTTP endpoint that accepts the same request/response
# shape as app/schemas/congestion.py, set this - no other code changes
# needed on the backend side.
CONGESTION_PREDICTION_API_URL=
CONGESTION_PREDICTION_API_TIMEOUT_SECONDS=3.0

# --- CORS ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- SMS gateway (OTP / notifications - backend-owned) --------------------
# Generic JSON SMS Gateway (optional)
SMS_GATEWAY_API_KEY=""
SMS_GATEWAY_BASE_URL=""

# Twilio SMS Gateway (Recommended for actual delivery)
TWILIO_ACCOUNT_SID="AC123456789..."
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_FROM_NUMBER="+1234567890"
SMS_GATEWAY_TIMEOUT_SECONDS=5.0

# --- Phone-number OTP verification (Phase 3) -------------------------------
# Independent of Firebase Authentication - see app/schemas/otp.py.
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
# Required dedicated server secret used to HMAC persisted OTP values.
# Generate a unique random value of at least 32 characters per environment.
OTP_HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters

# --- API -------------------------------------------------------------------
API_V1_PREFIX=/api/v1

# --- Deployment / docs ------------------------------------------------------
APP_VERSION=0.1.0
# Set to false in production if you don't want /docs, /redoc and
# /openapi.json publicly exposed.
ENABLE_DOCS=true
